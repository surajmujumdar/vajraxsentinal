# Global Server Configuration
APP_ENV=development
APP_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Platform Modes
VAJRA_ENABLED=true
SENTINEL_ENABLED=true

# Database Configuration (Dual Isolated SQLite)
DATABASE_URL="sqlite:///./ai_security.db"
VAJRA_DATABASE_URL="sqlite:///./ai_security.db"
SENTINEL_DATABASE_URL="sqlite:///./sentinal.db"

# Security & JWT Configuration
SECRET_KEY="unified-cybersecurity-platform-dev-secret-key-32-chars"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Sentinel AI Engine Settings
AI_PROVIDER="expert"
AI_MODEL="gpt-4o-mini"
