# ====================================================================
# UNIFIED CYBERSECURITY PLATFORM (VAJRA ↔ SENTINEL) CONFIGURATION
# Copy this file to `.env` and fill in the values for your environment.
# ====================================================================

# Global Server Configuration
APP_NAME=VAJRA
APP_VERSION=1.0.0
APP_ENV=development
APP_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
DEBUG=True

# Frontend Connectivity & WebSocket Endpoints
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Platform Modes
VAJRA_ENABLED=true
SENTINEL_ENABLED=true

# Database Configuration (Dual Isolated SQLite by Default)
DATABASE_URL=sqlite:///./ai_security.db
VAJRA_DATABASE_URL=sqlite:///./ai_security.db
SENTINEL_DATABASE_URL=sqlite:///./sentinal.db
POSTGRES_USER=ai_security_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=ai_security_platform

# Firebase Admin SDK
FIREBASE_SERVICE_ACCOUNT_KEY=./vajra-cdc56-firebase-adminsdk-fbsvc-b200c1088e.json

# Redis Cache & Queue
REDIS_URL=redis://localhost:6379/0

# Security & JWT Configuration
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Active Threat & Security API Keys
ALIENVAULT_OTX_API_KEY=
RANSOMWARE_LIVE_API_KEY=
URLSCAN_API_KEY=
NEWS_API_KEY=
WHOISXML_API_KEY=
GRIDINSOFT_API_KEY=
NVD_API_KEY=
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_API_KEYS=

# SMTP Email Settings (for live MFA OTP Email delivery)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=
RESEND_API_KEY=

# Sentinel AI Engine & Gemini Copilot Settings
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_BASE_URL=

# Scanner Orchestrator Limits
SCAN_TIMEOUT_SECONDS=300
MAX_CONCURRENT_SCANS=4
RETENTION_HOURS=24
GITHUB_DEFAULT_BRANCH=main
